#!/bin/sh

# Git hook: pre-push
# Comprehensive quality gate — runs lint, type-check, tests, coverage, and app-start verification.
# To skip (emergency only): git push --no-verify

BRANCH=$(git rev-parse --abbrev-ref HEAD)
if [ "$BRANCH" = "main" ] || [ "$BRANCH" = "master" ]; then
  echo ""
  echo "=========================================="
  echo "❌ PRE-PUSH FAILED"
  echo "=========================================="
  echo "Cannot push directly from '$BRANCH'."
  echo "Create a feature branch first:"
  echo "  git checkout -b feature/my-thing"
  echo ""
  exit 1
fi

echo "Running pre-push checks (branch: $BRANCH)..."

# ── Staged file scan for TODO/FIXME/debug code ───────
echo ""
echo "--- scanning staged files for leftover debug code ---"
STAGED=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null | grep -v '^\.githooks/')
if [ -n "$STAGED" ]; then
  ISSUES=$(echo "$STAGED" | xargs grep -ln 'TODO\|FIXME\|print(' 2>/dev/null)
  if [ -n "$ISSUES" ]; then
    echo ""
    echo "=========================================="
    echo "❌ PRE-PUSH FAILED"
    echo "=========================================="
    echo "Found TODO/FIXME/debug code in staged files:"
    echo "$ISSUES"
    echo ""
    exit 1
  fi
fi
echo "✅ no debug code found in staged files"

# ── Ruff lint check ──────────────────────────────────
echo ""
echo "--- ruff check ---"
ruff check .
RUFF_EXIT=$?
if [ $RUFF_EXIT -ne 0 ]; then
  echo ""
  echo "=========================================="
  echo "❌ PRE-PUSH FAILED"
  echo "=========================================="
  echo "Ruff linting errors found."
  echo "Run 'ruff check .' locally to see details."
  echo ""
  exit 1
fi
echo "✅ ruff passed"

# ── mypy type check ──
echo ""
echo "--- mypy ---"
python -m mypy --version >/dev/null 2>&1
MYPY_AVAILABLE=$?
if [ $MYPY_AVAILABLE -ne 0 ]; then
  echo "⚠️  mypy not available — skipping type check"
else
  python -m mypy . --explicit-package-bases --follow-imports=skip --disable-error-code=type-arg 2>/dev/null
  MYPY_EXIT=$?
  if [ $MYPY_EXIT -ne 0 ]; then
    echo "=========================================="
    echo "❌ PRE-PUSH FAILED"
    echo "=========================================="
    echo "Mypy type-checking errors found."
    echo "Run 'python -m mypy .' locally to see details."
    exit 1
  fi
  echo "✅ mypy passed"
fi

# ── pytest with coverage ─────────────────────────────
echo ""
echo "--- pytest (coverage >=100%) ---"
python -m pytest --cov-fail-under=100 -q 2>/dev/null
PYTEST_EXIT=$?
if [ $PYTEST_EXIT -ne 0 ]; then
  echo ""
  echo "=========================================="
  echo "❌ PRE-PUSH FAILED"
  echo "=========================================="
  echo "Tests or coverage checks did not pass."
  echo "Run 'pytest --cov --cov-report=term-missing' locally to see details."
  echo ""
  exit 1
fi
echo "✅ pytest + coverage passed"


# ── App import verification ──────────────────────────
echo ""
echo "--- verifying app modules can be imported ---"
MAIN=$(ls *.py 2>/dev/null | head -3)
if [ -n "$MAIN" ]; then
  python -c "
import sys
import types
# Mock comfy and server modules for import check
sys.modules['comfy'] = types.ModuleType('comfy')
sys.modules['comfy.utils'] = types.ModuleType('comfy.utils')
sys.modules['server'] = types.ModuleType('server')
# Try importing each top-level module
import importlib.util
for mod in ['_utils', 'Dynamic_Resolution_Picker', 'Image_Saver_Plus', 'LLM_Node', 'LLM_Fallback_Node', 'Resolution_Selector', 'Sequential_Image_Loader', 'Truncate_LLM_Thinking', 'Upscale_By_Max_Side', 'Wildcard_Reader']:
    try:
        importlib.util.spec_from_file_location(mod, mod + '.py')
    except Exception:
        pass
print('All modules importable')
" 2>/dev/null
  if [ $? -ne 0 ]; then
    echo ""
    echo "=========================================="
    echo "❌ PRE-PUSH FAILED"
    echo "=========================================="
    echo "App modules failed to import."
    exit 1
  fi
  echo "✅ app modules importable"
fi

echo ""
echo "=========================================="
echo "✅ PRE-PUSH CHECKS PASSED"
echo "=========================================="
exit 0
